{
  "manifest_version": 3,
  "name": "Media Monitor Browser Bridge",
  "version": "0.5.0",
  "description": "Makes 哔哩哔哩, 虎牙 and 抖音 web players available to the local Media Monitor menu bar app.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.huya.com/*",
    "*://*.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.huya.com/*",
        "*://*.douyin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "key": ""
}
